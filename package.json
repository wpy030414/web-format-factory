{
  "name": "web-format-factory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.0",
  "description": "Local, in-browser multimedia format converter. Files never leave the device.",
  "scripts": {
    "dev": "node scripts/copy-engines.mjs && vite",
    "build": "node scripts/copy-engines.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.prod.config.ts",
    "fixtures": "bash scripts/gen-fixtures.sh && node --experimental-strip-types scripts/make-livephoto-fixtures.ts",
    "engines": "node scripts/copy-engines.mjs"
  },
  "dependencies": {
    "@ffmpeg/core-mt": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "0.12.2",
    "@mediabunny/aac-encoder": "1.60.0",
    "@mediabunny/flac-encoder": "1.60.0",
    "@mediabunny/mp3-encoder": "1.60.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gifenc": "1.0.3",
    "heic-to": "1.5.2",
    "lucide-react": "^1.48.0",
    "mediabunny": "^1.60.0",
    "modern-gif": "2.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
